---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Magdalena Montiel · Psicoterapeuta en Pachuca y en línea',
  description = 'Psicoterapia individual, infantil, de pareja y familiar, y acompañamiento gerontológico con la Psic. Magdalena Montiel. Presencial en Pachuca, Hidalgo, y en línea. Primera asesoría gratuita.',
} = Astro.props;

const base = Astro.site ?? Astro.url;
const ogImage = new URL('/terapia-checklist.jpg', base).href;
const canonical = new URL(Astro.url.pathname, base).href;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <!-- Google Tag Manager -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-MP5NR2XM');
    </script>
    <!-- End Google Tag Manager -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#4B2E6F" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Cómo saber si deberías asistir a terapia — Magdalena Montiel, psicoterapeuta" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class="antialiased">
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-MP5NR2XM"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe
      ></noscript
    >
    <!-- End Google Tag Manager (noscript) -->
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-full focus:bg-ciruela focus:px-5 focus:py-3 focus:text-white"
    >
      Saltar al contenido
    </a>
    <slot name="header" />
    <main id="contenido" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
