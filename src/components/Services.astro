---
import { contact } from '../config/contact';
import { groups, services } from '../config/content';
---

<section id="servicios" aria-labelledby="servicios-title" class="bg-white py-16 md:py-24">
  <div class="wrap">
    <h2 id="servicios-title">Mis servicios</h2>
    <p class="measure mt-4 text-lg">Atiendo a cada persona según su etapa de vida y lo que está atravesando.</p>

    <dl class="mt-10 border-t-2 border-ciruela/15 md:mt-14">
      {
        services.map((s) => (
          <div class="row">
            <dt>{s.audience}</dt>
            <dd>
              <p>{s.description}</p>
              {'hasGroups' in s && (
                <div class="mt-5 rounded-lg bg-mantequilla p-5 md:p-6">
                  <p class="font-display text-lg">Grupos de apoyo</p>
                  <p class="mt-1 font-semibold">{contact.groupsSchedule}</p>
                  <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-1">
                    {groups.map((g) => (
                      <li>{g}</li>
                    ))}
                  </ul>
                </div>
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .row {
    display: grid;
    gap: 0.5rem 2.5rem;
    padding-block: 1.75rem;
    border-bottom: 2px solid color-mix(in srgb, var(--color-ciruela) 15%, transparent);
  }

  @media (min-width: 768px) {
    .row {
      grid-template-columns: 16rem minmax(0, 38rem);
      padding-block: 2.25rem;
    }
  }

  dt {
    font-family: var(--font-display);
    font-size: 1.375rem;
    line-height: 1.25;
  }
</style>
