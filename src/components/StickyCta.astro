---
import WhatsAppButton from './WhatsAppButton.astro';
---

<div
  id="sticky-cta"
  class="fixed inset-x-0 bottom-0 z-30 border-t border-ciruela/10 bg-bruma/95 px-4 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] backdrop-blur md:hidden"
>
  <WhatsAppButton class="w-full" />
</div>

<script>
  const bar = document.getElementById('sticky-cta');
  const hero = document.getElementById('hero-cta');
  const footer = document.getElementById('contacto');

  if (bar && hero && footer && 'IntersectionObserver' in window) {
    let heroVisible = true;
    let footerVisible = false;
    const update = () => {
      const hidden = heroVisible || footerVisible;
      bar.toggleAttribute('data-hidden', hidden);
      bar.toggleAttribute('inert', hidden);
    };
    new IntersectionObserver(([e]) => {
      heroVisible = e.isIntersecting;
      update();
    }).observe(hero);
    new IntersectionObserver(([e]) => {
      footerVisible = e.isIntersecting;
      update();
    }).observe(footer);
    update();
  }
</script>

<style>
  #sticky-cta {
    transition: transform 0.25s ease-out;
  }

  #sticky-cta[data-hidden] {
    transform: translateY(110%);
  }
</style>
