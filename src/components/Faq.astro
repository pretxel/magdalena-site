---
import { faq } from '../config/content';
---

<section id="preguntas" aria-labelledby="preguntas-title" class="py-16 md:py-24">
  <div class="wrap">
    <h2 id="preguntas-title">Preguntas frecuentes</h2>

    <div class="mt-10 grid gap-x-16 gap-y-10 md:mt-14 md:grid-cols-2">
      {
        faq.map((item) => (
          <div class="border-l-4 border-agua pl-5">
            <h3>{item.question}</h3>
            <p class="mt-2">{item.answer}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
