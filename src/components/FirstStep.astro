---
import WhatsAppButton from './WhatsAppButton.astro';

const steps = [
  {
    title: 'Escríbeme por WhatsApp',
    text: 'Cuéntame en pocas palabras qué te trae o simplemente pregunta. Respondo personalmente.',
  },
  {
    title: 'Asesoría gratuita',
    text: 'Platicamos sin compromiso para entender qué necesitas y si la terapia es para ti.',
  },
  {
    title: 'Primera sesión',
    text: 'Agendamos tu primera sesión, presencial en Pachuca o en línea, como te quede mejor.',
  },
];
---

<section id="primer-paso" aria-labelledby="primer-paso-title" class="bg-white py-16 md:py-24">
  <div class="wrap">
    <h2 id="primer-paso-title">Tu primer paso</h2>

    <ol class="mt-10 grid gap-10 md:mt-14 md:grid-cols-3 md:gap-8" role="list">
      {
        steps.map((s, i) => (
          <li class="grid grid-cols-[auto_1fr] gap-x-4 md:block">
            <span class="font-display text-5xl leading-none text-agua md:text-6xl" aria-hidden="true">
              {i + 1}
            </span>
            <div class="md:mt-4">
              <h3>{s.title}</h3>
              <p class="mt-2 max-w-[32ch]">{s.text}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <WhatsAppButton size="lg" class="mt-12" />
  </div>
</section>
