---
import WhatsAppButton from './WhatsAppButton.astro';
import Spiral from './Spiral.astro';

const links = [
  { href: '#servicios', label: 'Servicios' },
  { href: '#como-trabajo', label: 'Cómo trabajo' },
  { href: '#primer-paso', label: 'Primer paso' },
  // Four links only fit next to the CTA from the xl breakpoint up.
  { href: '#preguntas', label: 'Preguntas', wideOnly: true },
];
---

<header class="sticky top-0 z-40 border-b border-ciruela/10 bg-bruma/95 backdrop-blur supports-[backdrop-filter]:bg-bruma/80">
  <div class="wrap flex h-16 items-center justify-between gap-4 md:h-[4.5rem]">
    <a href="#inicio" class="flex items-center gap-2.5 rounded-sm">
      <Spiral class="size-8 text-agua" strokeWidth={14} />
      <span class="leading-tight">
        <span class="block font-display text-lg">Magdalena Montiel</span>
        <span class="block text-sm text-ciruela/75">Psicoterapeuta</span>
      </span>
    </a>

    <nav aria-label="Secciones" class="hidden lg:block">
      <ul class="flex items-center gap-8">
        {
          links.map((l) => (
            <li class:list={[{ 'hidden xl:block': 'wideOnly' in l }]}>
              <a href={l.href} class="whitespace-nowrap underline-offset-4 decoration-2 decoration-agua hover:underline">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hidden sm:block">
      <WhatsAppButton size="sm" />
    </div>
  </div>
</header>
